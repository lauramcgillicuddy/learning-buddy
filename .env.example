ANTHROPIC_API_KEY=your_anthropic_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ElevenLabs voice ID — Charlotte (RP British) is a good default
# Find more at: elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa

# Reachy Mini IP on your local WiFi
REACHY_HOST=reachy.local

# Where ChromaDB persists its data
CHROMA_DB_PATH=./data/chroma

# Whisper model size: tiny, base, small, medium, large
# 'base' is fast and accurate enough for clear speech
WHISPER_MODEL=base
